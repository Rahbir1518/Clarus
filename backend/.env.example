# ---------------------------------------------------------------------------
# Required — the app refuses to start without these.
# ---------------------------------------------------------------------------

# Supabase. The service role key bypasses Row Level Security entirely, so it
# must never reach the browser. Tenant isolation is enforced in app/db/tenancy.py.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk. This is the Frontend API origin, with no trailing slash — find it in
# Clerk Dashboard -> Configure -> API keys, or as the `iss` claim of any session
# token. It is both the issuer we verify against and the root of the JWKS URL.
# Development instances end in .clerk.accounts.dev; production instances are
# your own domain. They are separate instances with separate keys: pointing at
# the wrong one 401s every request.
CLERK_ISSUER=https://your-slug.clerk.accounts.dev

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Comma-separated origins allowed to present a token, checked against the `azp`
# claim. Clerk scopes each session token to the origin that requested it, so
# this stops a token issued to another app on the same Clerk instance from
# working here. Empty skips the check — fine locally, a real gap in production.
# CLERK_AUTHORIZED_PARTIES=https://clarus.health,http://localhost:3000

# Only if you mint tokens from a Clerk JWT template that sets an audience.
# Default session tokens have no `aud` claim, and setting this without a
# matching template rejects every token.
# CLERK_AUDIENCE=

# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for dynamic origins. Starlette's allow_origins does exact string
# matching and does NOT expand globs — "https://*.vercel.app" silently matches
# nothing. Use this instead for preview deployments.
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# ---------------------------------------------------------------------------
# ElevenLabs — needed for calling. Validated at point of use, not at startup,
# so the rest of the API still runs without them. See README "ElevenLabs".
# ---------------------------------------------------------------------------

# Developers -> API Keys
ELEVENLABS_API_KEY=

# Printed by `python scripts/sync_agent.py`.
ELEVENLABS_AGENT_ID=

# Listed by `python scripts/test_call.py --list-numbers`. Your Twilio number,
# imported into ElevenLabs under Agents -> Phone Numbers.
ELEVENLABS_PHONE_NUMBER_ID=

# The English agent, used for calls over Twilio (the US and Canada under
# CALL_TRANSPORT=auto). ELEVENLABS_AGENT_ID stays the Bangla one for WhatsApp
# and browser calls. Created by:
#   python scripts/sync_agent.py --spec agents/appointment_confirmation.yaml
# Empty means Twilio calls use ELEVENLABS_AGENT_ID.
ELEVENLABS_TWILIO_AGENT_ID=

# How outbound calls reach patients: "twilio", "whatsapp" or "web". Same agent,
# same webhook every way. Anything else is refused rather than defaulted.
#
# "web" dials nothing: a workflow's Call Patient step parks the run, the call
# appears on /call-test under "Waiting to be answered", and answering it in the
# browser plays the patient. The run resumes from the post-call webhook as it
# would after a phone call. For demos and testing without a number. Needs
# migrations/003_browser_calls.sql. CALLS_ENABLED, the calling hours and the
# attempt cap still apply; the phone-number checks (E.164, allowlist) do not.
#
# "auto" chooses per call by the country of the patient's number: numbers in
# TWILIO_REGIONS go over Twilio, every other country over WhatsApp. Needs both
# the Twilio and the WhatsApp settings below. A number whose country cannot be
# told is not called.
CALL_TRANSPORT=whatsapp

# CALL_TRANSPORT=auto only: ISO region codes dialled over Twilio. "+1" also
# covers the Caribbean; those go to WhatsApp unless listed (e.g. add PR).
TWILIO_REGIONS=US,CA

# WhatsApp (ElevenLabs -> WhatsApp page -> Import account). This is the phone
# number ID from the account's menu ("Copy phone number ID"), not the number.
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=

# A Meta-approved template with a call-permission-request component, created in
# WhatsApp Manager. WhatsApp will not let a business call someone who has not
# granted permission; ElevenLabs sends this template to ask for it.
WHATSAPP_CALL_PERMISSION_TEMPLATE_NAME=
# Meta language code of that template: bn, en_US, ...
WHATSAPP_CALL_PERMISSION_TEMPLATE_LANGUAGE=bn

# Signing secret from the post-call webhook settings.
# NOT OPTIONAL IN PRACTICE: leaving this empty does not disable verification,
# it makes the webhook route reject every request. That is deliberate — an
# unset secret must never be read as "trust anything that arrives".
ELEVENLABS_WEBHOOK_SECRET=

# How much clock skew to tolerate before a signature counts as a replay.
# WEBHOOK_TOLERANCE_SECONDS=300

# Calendar tools: during a call the agent asks the backend which appointment
# times are free (app/api/routes/agent_tools.py). Opening hours and appointment
# length are NOT here — each practice sets them in the app (Settings -> Clinic
# hours), and the free times come from the Appointments calendar.
#
# Any long random string; ElevenLabs sends it on every tool call. Empty refuses
# every tool call. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ELEVENLABS_TOOL_SECRET=
# The backend's public https origin — the ngrok URL in development. Read only by
# scripts/sync_agent.py, which registers the tools at this address. Re-run the
# sync if it changes.
PUBLIC_API_URL=
# How far ahead patients may book, and how much the agent is told per lookup.
# AVAILABILITY_HORIZON_DAYS=14
# AVAILABILITY_DAYS_OFFERED=3
# AVAILABILITY_TIMES_PER_DAY=8
# Appointment length for a practice that has not chosen one in Settings.
# DEFAULT_APPOINTMENT_MINUTES=30

# ---------------------------------------------------------------------------
# What the agent says about itself. Both are spoken to a patient, so neither is
# accepted from a request body.
# ---------------------------------------------------------------------------

PRACTICE_NAME=Clarus

# The number a voicemail asks the patient to ring. A workflow that would leave a
# voicemail with nothing to call back on is refused rather than left to say
# something useless.
PRACTICE_CALLBACK_NUMBER=

# IANA name. Spoken to the agent so it resolves "next Tuesday" correctly, and
# the zone the calling-hours window below is measured in.
DEFAULT_TIMEZONE=Asia/Dhaka

# ---------------------------------------------------------------------------
# Outbound call gates — see docs/ai-call-safety-policy.md.
#
# Every default is the restrictive one. Each of these is a variable somebody
# will forget to set, and a forgotten variable must mean fewer calls than
# intended, never more.
# ---------------------------------------------------------------------------

# The kill switch. Left false, no workflow places a call however well the rest
# of this file is filled in. Turning it on is a deliberate sentence you write
# once you have watched the gates below refuse the calls you expected them to.
CALLS_ENABLED=false

# Comma-separated E.164 numbers that may be dialled. While the allowlist is
# enforced, an empty list means nothing is callable — so during testing put your
# own number here and only your own phone can ring. scripts/test_call.py dials
# the first entry by default and refuses anything not listed.
# TEST NUMBER: your own WhatsApp number, e.g. +8801712345678 (or your current
# non-BD number until the Bangladesh number arrives).
CALL_ALLOWED_NUMBERS=
CALL_ALLOWLIST_ENFORCED=true

# Local hours in DEFAULT_TIMEZONE when a patient may be called: start inclusive,
# end exclusive. Requires the `tzdata` package on Windows; without it the zone
# fails to load and the gate refuses every call rather than guessing UTC.
CALLING_HOURS_START=9
CALLING_HOURS_END=20

# Calls actually placed to one patient in the trailing 24 hours. A run blocked
# before dialling does not consume an attempt.
MAX_CALL_ATTEMPTS_PER_PATIENT=3

# ---------------------------------------------------------------------------
# Contact form (public site)
# ---------------------------------------------------------------------------

# Messages from /contact are emailed to CONTACT_TO_EMAIL through this account,
# with the visitor's address as Reply-To. For Gmail use an App Password
# (Google Account > Security > 2-Step Verification > App passwords), never the
# account password. Leave either blank and the form answers 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=info.cl4rus@gmail.com
SMTP_PASSWORD=
CONTACT_TO_EMAIL=info.cl4rus@gmail.com

# Set true only behind a proxy that sets X-Forwarded-For (Render, Fly, nginx).
TRUST_FORWARDED_FOR=false

# ---------------------------------------------------------------------------
# Not yet ported to this backend. Kept as a record of what the rebuild needs.
# ---------------------------------------------------------------------------

# Twilio credentials are given to ElevenLabs when importing the number; the
# backend itself does not call Twilio yet.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Clerk secret key. Not needed to verify tokens — that only requires the public
# JWKS at CLERK_ISSUER. Add it when the backend needs to call Clerk's Backend
# API (reading a user profile, listing organization members).
# CLERK_SECRET_KEY=
