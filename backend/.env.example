# ---------------------------------------------------------------------------
# Required — the app refuses to start without these.
# ---------------------------------------------------------------------------

# Supabase. The service role key bypasses Row Level Security entirely, so it
# must never reach the browser. Tenant isolation is enforced in app/db/tenancy.py.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth0. AUTH0_AUDIENCE is the API identifier you register under
# Auth0 Dashboard -> Applications -> APIs. The frontend must request this exact
# same audience in Auth0Provider's authorizationParams, or Auth0 issues an
# opaque token instead of a JWT and every request here will 401.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.clarus.health

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for dynamic origins. Starlette's allow_origins does exact string
# matching and does NOT expand globs — "https://*.vercel.app" silently matches
# nothing. Use this instead for preview deployments.
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# ---------------------------------------------------------------------------
# ElevenLabs — needed for calling. Validated at point of use, not at startup,
# so the rest of the API still runs without them. See README "ElevenLabs".
# ---------------------------------------------------------------------------

# Developers -> API Keys
ELEVENLABS_API_KEY=

# Printed by `python scripts/sync_agent.py`.
ELEVENLABS_AGENT_ID=

# Listed by `python scripts/test_call.py --list-numbers`. Your Twilio number,
# imported into ElevenLabs under Agents -> Phone Numbers.
ELEVENLABS_PHONE_NUMBER_ID=

# Signing secret from the post-call webhook settings.
# NOT OPTIONAL IN PRACTICE: leaving this empty does not disable verification,
# it makes the webhook route reject every request. That is deliberate — an
# unset secret must never be read as "trust anything that arrives".
ELEVENLABS_WEBHOOK_SECRET=

# How much clock skew to tolerate before a signature counts as a replay.
# WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Not yet ported to this backend. Kept as a record of what the rebuild needs.
# ---------------------------------------------------------------------------

# Twilio credentials are given to ElevenLabs when importing the number; the
# backend itself does not call Twilio yet.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=
